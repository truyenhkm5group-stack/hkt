# Caddy tự xin và gia hạn chứng chỉ Let's Encrypt cho {$ERP_DOMAIN}
#
# TÊN MIỀN CON CỦA TỔ CHỨC (0180): on-demand TLS — Caddy chỉ xin chứng chỉ cho `<slug>.{$ERP_DOMAIN}` khi app trả 200 ở
# /api/platform/domain-allowed (chỉ tổ chức ĐÃ XUẤT BẢN). Không có bản ghi DNS `*.{$ERP_DOMAIN}` thì khối dưới cùng không
# bao giờ nhận request nào — cấu hình một lần cho cả nền tảng, không sửa gì cho từng khách.
{
	on_demand_tls {
		ask http://app:3000/api/platform/domain-allowed
	}
}

{$ERP_DOMAIN} {
	encode gzip zstd

	# ─── TRẦN BODY CỦA WEBHOOK (cửa không đăng nhập) ───
	# Chặn body quá cỡ TRƯỚC khi byte nào tới Node. Số là BYTE, và phải KHỚP hằng số trong
	# lib/constants/webhook-limits.ts — tests/webhook-hardening.test.ts đọc tệp này để đòi điều đó.
	# Handler vẫn tự kiểm lại (lib/http/body-limit.ts) cho máy dev không có Caddy.
	@vtpWebhook path /api/webhooks/viettelpost /api/webhooks/viettelpost/
	request_body @vtpWebhook {
		# VTP_WEBHOOK_MAX_BODY_BYTES = 1 MiB
		max_size 1048576
	}
	@vtpStatement path /api/webhooks/vtp-statement /api/webhooks/vtp-statement/
	request_body @vtpStatement {
		# VTP_STATEMENT_MAX_BODY_BYTES = MAX_LIST_FILES × (MAX_LIST_BASE64 + 1024) + 64 KiB
		max_size 240106496
	}
	@pancakeWebhook path /api/webhooks/pancake/*
	request_body @pancakeWebhook {
		# PANCAKE_WEBHOOK_MAX_BODY_BYTES = 5 MiB
		max_size 5242880
	}
	@sepayWebhook path /api/webhooks/sepay /api/webhooks/sepay/
	request_body @sepayWebhook {
		# SEPAY_WEBHOOK_MAX_BODY_BYTES = 256 KiB
		max_size 262144
	}

	reverse_proxy app:3000 {
		# SSE realtime (/api/events) cần giữ kết nối lâu
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
	log {
		output stdout
		# ─── KHÔNG IN BÍ MẬT VÀO LOG TRUY CẬP ───
		# Webhook Pancake mang bí mật TRÊN ĐƯỜNG DẪN, webhook Viettel Post nhận `?token=` — URL đã
		# đăng ký với hai bên nên KHÔNG đổi được. Thay vào đó che chúng ở đây: đoạn bí mật sau
		# /api/webhooks/pancake/ và giá trị của token / secret / access_token trên query.
		# Header mang bí mật bị xoá khỏi bản ghi (Authorization / Cookie Caddy đã tự che).
		format filter {
			wrap console
			fields {
				request>uri regexp "(/api/webhooks/pancake/(?:fanpage/)?)[^/?]+|([?&](?i:token|secret|access_token)=)[^&]*" "${1}${2}REDACTED"
				request>headers>Token delete
				request>headers>Secret delete
				request>headers>X-Token delete
				request>headers>X-Secret delete
				request>headers>X-Webhook-Secret delete
				request>headers>X-Api-Key delete
				request>headers>X-Cron-Secret delete
			}
		}
	}
}

# ERP của tổ chức đã xuất bản: `<slug>.{$ERP_DOMAIN}` → cùng app; app đọc host để chọn tổ chức (lib/platform/host-org.ts).
*.{$ERP_DOMAIN} {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy app:3000 {
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri regexp "([?&](?i:token|secret|access_token)=)[^&]*" "${1}REDACTED"
			}
		}
	}
}

# TRANG GIỚI THIỆU ở tên miền gốc: `{$SITE_DOMAIN}` + `www.` → cùng app; middleware nhận ra host và chỉ phục vụ trang giới
# thiệu, mọi đường dẫn khác chuyển sang {$ERP_DOMAIN} (lib/platform/site-host.ts). Chứng chỉ xin THEO YÊU CẦU (hỏi
# /api/platform/domain-allowed như khối trên): trước khi bản ghi DNS A của tên miền gốc trỏ về máy này, khối này không nhận
# request nào và Caddy không gọi Let's Encrypt lần nào — thêm khối không có rủi ro đốt hạn mức.
{$SITE_DOMAIN:vnxcommerce.com}, www.{$SITE_DOMAIN:vnxcommerce.com} {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri regexp "([?&](?i:token|secret|access_token|invite)=)[^&]*" "${1}REDACTED"
			}
		}
	}
}
