# ───────────── ROUTE CADDY CHO BẢN CHẠY THỬ NHÂN SỰ AI ─────────────
#
# Khối này ĐƯỢC NỐI VÀO CUỐI /etc/caddy/Caddyfile. Nó KHÔNG sửa một dòng nào của khối
# {$ERP_DOMAIN} đang phục vụ khách — thêm một tên miền là phép CỘNG, và quay lui là phép trừ
# đúng khối này.
#
# Áp dụng bằng thao tác ops `ai-staging-domain` (validate → reload). Đừng sửa tay trên máy chủ:
# thao tác ấy kiểm cấu hình TRƯỚC khi nạp, còn tay thì không.
#
# ═══ VÌ SAO KHÔNG PHẢI `reverse_proxy 127.0.0.1:3100` ═══
#
# Caddy chạy TRONG container `erp-caddy`. `127.0.0.1` ở đó là chính container ấy, không phải máy
# chủ — proxy tới đó là proxy vào hư không. Bản chạy thử lại publish `127.0.0.1:3100` nên từ trong
# container cũng không với tới được, và đó là điều ĐÚNG: cổng 3100 không bao giờ được nghe trên
# 0.0.0.0, vì thế là mở thẳng bản chạy thử ra Internet, đi vòng qua cả Caddy lẫn HTTPS.
#
# Đường đã chọn: nối `erp-caddy` vào MẠNG của bản chạy thử rồi gọi thẳng tên container.
#
#   docker network connect vnx-ai-staging_default erp-caddy
#
# `docker network connect` gắn thêm một giao diện mạng vào container ĐANG CHẠY — KHÔNG dựng lại,
# KHÔNG đứt một kết nối nào của khách. Gỡ ra cũng vậy (`docker network disconnect`). Không phải
# publish thêm cổng nào, không phải sửa `docker-compose.prod.yml`, không phải đụng tới
# `docker-compose.staging.yml`.
#
# Hai đường còn lại đã cân nhắc và loại:
#   · Đổi cổng của bản chạy thử sang địa chỉ cổng mạng bridge (172.x.0.1:3100): phải dựng lại bản
#     chạy thử, và mở cổng ấy cho MỌI container trên bridge mặc định.
#   · `extra_hosts: host.docker.internal` cho service caddy: phải sửa compose của production rồi
#     DỰNG LẠI container Caddy — tức làm đứt tên miền của khách một nhịp. Loại thẳng.
#
# ═══ VÌ SAO KHÔNG CÓ `basic_auth` Ở ĐÂY ═══
#
# Quyền truy cập dùng LẠI đăng nhập của ERP: middleware đòi phiên hợp lệ cho mọi đường ngoài
# `/login` và vài đường công khai, trang `/ai/*` đòi quyền `ai:view`, và mọi thao tác gửi đi qua
# `requireUser()` + `can(user, "ai:send")`. Một mật khẩu dùng chung đặt thêm ở đây KHÔNG thêm một
# lớp quy kết nào — nó chỉ thêm một bí mật nữa để quên, và che mất việc ai đã bấm gì.
#
# ĐÁNH ĐỔI CÒN LẠI, nói thẳng để chủ shop quyết: không có `basic_auth` thì TRANG ĐĂNG NHẬP của bản
# chạy thử là công khai. Muốn thêm hàng rào ngoài, chèn khối dưới đây vào ngay trước `reverse_proxy`
# rồi chạy lại thao tác ops:
#
#   basic_auth {
#       staging <chuỗi băm>     # docker run --rm caddy caddy hash-password --plaintext '<mật khẩu>'
#   }

ai-staging.vnxcommerce.com {
	encode gzip zstd

	# Tên CONTAINER của bản chạy thử, không phải tên service: `app` là tên service ở CẢ HAI ngăn xếp,
	# nên gọi `app` từ một container nối vào hai mạng là để Docker chọn hộ — và nó có thể chọn
	# container đang phục vụ khách.
	reverse_proxy vnx-ai-staging-app:3000 {
		# SSE realtime (/api/events) giữ kết nối lâu — giống cấu hình của production.
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}

	header {
		# Bản chạy thử chứa hội thoại THẬT của khách: không bao giờ để công cụ tìm kiếm đánh chỉ mục.
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		# Để người mở nhầm tab biết ngay mình đang ở đâu.
		X-Environment "ai-staging"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		# Nhật ký RIÊNG, không trộn vào nhật ký production.
		output file /var/log/caddy/ai-staging.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}
