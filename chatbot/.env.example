# ===== Server =====
PORT=3456
WEBHOOK_PATH=/webhook/pancake
# Chuoi bi mat tu dat. Neu dat, URL webhook phai co ?secret=... (vi Pancake khong ky payload)
WEBHOOK_SECRET=

# ===== Pancake (pages.fm) =====
# Lay tai: Pancake -> Page -> Cai dat -> Cong cu -> Page Access Token
PANCAKE_PAGE_ID=
PANCAKE_PAGE_ACCESS_TOKEN=
# Ten shop (dung cho {{SHOP_NAME}} trong prompt) khi chi co 1 page
SHOP_NAME=
# Nhieu page: JSON {"page_id":{"token":"...","name":"Ten shop"}, ...}  (cung nhan dang {"page_id":"token"})
PANCAKE_PAGES_JSON=

# ===== Pancake POS (tuy chon: dong bo san pham, gia, ton kho, anh) =====
# Lay tai: POS -> Cai dat -> API. Chay `npm run test:pos` de kiem tra
POS_SHOP_ID=
POS_API_KEY=
POS_SYNC_MINUTES=10
# order = moi bien the deu dat duoc (shop cho ban am) | strict = chi bao con hang khi ton kho > 0
POS_STOCK_MODE=order
# Bot gui anh san pham cho khach khi Gemini them [[IMG:ma]] vao cau tra loi
SEND_PRODUCT_IMAGES=true
# Bot chot don xong -> tu ghi vao don nhap POS (san pham, SDT, dia chi chuan hoa theo tinh/huyen/xa). Khong bao gio xac nhan don.
ORDER_SYNC=true
# Kho mac dinh khi tao don (id kho trong POS; trong = de POS tu chon)
POS_WAREHOUSE_ID=b2fc137e-a209-45fe-81af-5b2cc7bc89ae
MAX_PRODUCT_IMAGES=12
# Moi tin nhan toi da N anh, nhieu hon thi chia nhieu tin
IMAGES_PER_MESSAGE=6

# ===== Google Gemini =====
# Lay tai: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chay `npm run test:gemini` de xem danh sach model kha dung
# gemini-2.5-flash-lite (re, nhanh, du tot cho kich ban ban hang) hoac gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=1024
# So request Gemini chay song song toi da (key mien phi: 3-4; tra phi: 10-20)
GEMINI_MAX_CONCURRENT=4
# 0 = tat "suy nghi" cua Gemini cho bot ban hang (nhanh gap doi), -1 = tu dong
GEMINI_THINKING_BUDGET=0
# Model cho tro ly AI trong app quan ly (function calling); trong = dung GEMINI_MODEL
ASSISTANT_MODEL=gemini-3.5-flash

# ===== Hanh vi bot =====
SYSTEM_PROMPT_FILE=prompts/system.md
# So tin nhan gan nhat dua vao ngu canh
HISTORY_LIMIT=12
# Khi khach bao "da nhan roi": doc lai toi da N tin (tai them tu Pancake)
HISTORY_LIMIT_RECHECK=60
# Doi X ms de gom cac tin khach gui lien tiep roi tra loi 1 lan (0 = tra loi ngay)
DEBOUNCE_MS=0
# true = tra loi ca binh luan (comment) duoi bai viet
# Binh luan duoi bai viet: off = khong tra loi | public = tra loi cong khai ngan | inbox = nhan rieng vao inbox (bao gia day du) + 1 cau cong khai
COMMENT_MODE=off
# Cau tra loi cong khai duoi binh luan ({name} = ten khach): chao + bao check inbox
COMMENT_PUBLIC_TEXT=Dạ em chào chị{name} ❤️ Shop đã gửi báo giá và ảnh mẫu vào tin nhắn cho chị rồi ạ, chị kiểm tra Messenger giúp em nhé!
# Tat bot theo TEN tag (moi page tu tra id): tao tag nay tren tung page trong Pancake
BOT_PAUSE_TAG_NAME=BOT OFF
# hoac theo id (chi dung khi 1 page)
BOT_PAUSE_TAG_ID=
# 0 = bot luon tra loi, chi bo qua khi nhan vien da tra loi tin do roi; N > 0 = im lang N phut sau khi nhan vien tra loi
HUMAN_TAKEOVER_MINUTES=0
# Bot bat dau tra loi tu tin thu may cua khach. 1 = ngay tin dau. 2 = de Pancake tu dong tra loi tin dau (gui anh/bao gia), bot vao tu tin thu 2
MIN_CUSTOMER_MESSAGES=1
# (tuy chon) user id trong Pancake dung lam nguoi gui cua bot (xem `npm run test:pancake`)
BOT_SENDER_ID=

# ===== Xem anh (vision) =====
# true = khi khach gui anh, bot tai anh va dua vao Gemini de tu van
VISION_ENABLED=true
# Model rieng cho buoc nhan dien anh khach gui (lite hay nham)
VISION_MODEL=gemini-2.5-flash
# So anh gan nhat toi da dua vao moi lan goi Gemini
VISION_MAX_IMAGES=4
# Bo qua anh lon hon X MB
VISION_MAX_IMAGE_MB=5

# ===== Che do poll (dung khi chua duoc Pancake bat webhook) =====
POLL_ENABLED=false
POLL_INTERVAL_SEC=5
# Chi tra loi hoi thoai co tin moi trong vong N phut (tranh tra loi hang loat tin cu khi vua bat bot)
POLL_MAX_AGE_MIN=10

# ===== Bam khach chua chot (sales agent) =====
# Quet lai moi N phut de bam nhung khach da im lang. 0 = tat hoan toan (chi bam tay trong app).
# Bat so nay van chua du: tung page phai tick "Tu dong bam khach" trong tab "Bam khach".
FOLLOWUP_INTERVAL_MIN=0

# ===== App quan ly =====
# Mac dinh chi mo duoc tu chinh may chay bot. Dat token neu muon mo tu may khac: http://ip:3000/admin?token=...
ADMIN_TOKEN=

# ===== Giam sat (tuy chon) =====
# URL healthchecks.io / hc-ping.com, bot ping dinh ky de biet con song
HEALTHCHECK_URL=
HEALTHCHECK_INTERVAL_MIN=5

# ===== Khac =====
# true = chi log cau tra loi, KHONG gui cho khach
DRY_RUN=false
DATA_DIR=data
LOG_LEVEL=info

# ===== Nha cung cap AI: gemini (mac dinh) | openai (ChatGPT) =====
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_CONCURRENT=6
OPENAI_REASONING=none
