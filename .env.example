# ───────────── Cơ sở dữ liệu ─────────────
# Khi chạy bằng Docker Compose, giá trị này được đặt sẵn trong docker-compose.yml
DATABASE_URL="postgresql://erp:erp_secret@localhost:5432/erp?schema=public"

# ───────────── Bảo mật ứng dụng ─────────────
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập (openssl rand -hex 32)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Tài khoản quản trị được tạo lần đầu khi seed
ADMIN_EMAIL="admin@shop.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Quản trị viên"

# Khoá cho bộ lập lịch / Vercel Cron gọi API đồng bộ (openssl rand -hex 24)
CRON_SECRET="thay-bang-chuoi-ngau-nhien"

# URL công khai của ERP (dùng để hiển thị đường dẫn webhook)
APP_URL="http://localhost:3000"

# ───────────── Pancake POS ─────────────
PANCAKE_API_KEY="dien-api-key-pancake"
PANCAKE_SHOP_ID="dien-shop-id"
PANCAKE_BASE_URL="https://pos.pages.fm/api/v1"
# Bí mật gắn vào URL webhook Pancake: https://<domain>/api/webhooks/pancake/<PANCAKE_WEBHOOK_SECRET>
PANCAKE_WEBHOOK_SECRET="doi-thanh-chuoi-bi-mat-cua-ban"
# Đồng bộ lùi bao nhiêu ngày khi chạy backfill lần đầu
PANCAKE_BACKFILL_DAYS="365"

# ───────────── Viettel Post ─────────────
# Cách 1 (khuyên dùng): token bí mật tạo tại https://viettelpost.vn/cau-hinh-tai-khoan → "Thêm mới token"
VIETTELPOST_API_KEY="dien-token-bi-mat-viettelpost"
# Cách 2 (tuỳ chọn): tài khoản đối tác để lấy token dài hạn 1 năm (Login → ownerconnect)
VIETTELPOST_USERNAME=""
VIETTELPOST_PASSWORD=""
VIETTELPOST_BASE_URL="https://partner.viettelpost.vn/v2"
# "Tham số bí mật" bạn khai báo trong phần Cấu hình tài khoản → Thông tin nhận hành trình (webhook)
VIETTELPOST_WEBHOOK_SECRET="doi-thanh-chuoi-bi-mat-webhook-vtp"

# ───────────── Facebook Ads ─────────────
# Token System User (Business Settings → System Users → Generate token, quyền ads_read + business_management)
FACEBOOK_ACCESS_TOKEN=""
# ID Business Manager chứa các tài khoản quảng cáo
FACEBOOK_BUSINESS_ID="336423739082347"
FACEBOOK_API_VERSION="v21.0"
# Tỷ giá quy đổi nếu tài khoản quảng cáo tính bằng USD
FACEBOOK_USD_VND="25500"

# ───────────── Bộ lập lịch (scheduler) ─────────────
ERP_INTERNAL_URL="http://localhost:3000"
SYNC_ORDERS_EVERY_MINUTES="3"
SYNC_VTP_EVERY_MINUTES="10"
SYNC_PRODUCTS_EVERY_MINUTES="30"
SYNC_CUSTOMERS_EVERY_MINUTES="60"
SYNC_INVENTORY_EVERY_MINUTES="60"
SYNC_RETURNS_EVERY_MINUTES="30"
SYNC_ADS_EVERY_MINUTES="60"

# ── AI Copilot (tuỳ chọn) ──
# Chọn provider: auto (mặc định: OpenAI nếu có OPENAI_API_KEY, không thì Anthropic) · openai · anthropic · off
AI_PROVIDER=auto
# Khoá API — chỉ SDK đọc, không log, không commit. Thiếu cả hai ⇒ giao diện hiện "AI chưa được cấu hình", app vẫn chạy.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ghi đè model bậc copilot (trống = theo lib/ai/router.ts: gpt-5.6-terra / claude-opus-5)
AI_MODEL=
# Trống = theo bậc (routine low · copilot medium · analysis high)
AI_EFFORT=
AI_MAX_TOOL_ROUNDS=6
SYNC_CHAT_EVERY_MINUTES="15"
# Nạp hội thoại Pancake cho nhân sự AI (job ai-sales-ingest).
# CHƯA có hiệu lực: dòng lịch tương ứng trong scripts/scheduler.mjs đang để chú thích, chờ chủ shop bật.
SYNC_AI_SALES_EVERY_MINUTES="10"

# ───────────── Nhân sự AI (AI Workforce) ─────────────
# Nền tảng chạy được mà KHÔNG cần khoá mô hình: nhà cung cấp "stub" không gọi mạng, dây chuyền
# chạy hết nấc luật rồi chuyển người ở phần cần mô hình. Đó là hành vi mong muốn, không phải bản cụt.
# TÊN RIÊNG, KHÔNG DÙNG CHUNG với AI_PROVIDER của AI Copilot ở khối trên: hai hệ có bộ giá trị khác
# nhau (Copilot: auto|openai|anthropic|off · nhân sự AI: stub|anthropic). Đọc chung một biến là hai
# hệ cùng hiểu sai. AI_WORKFORCE_PROVIDER thắng; không khai thì mới xét AI_PROVIDER, và chỉ nhận khi
# nó là tên nhà cung cấp mà nhân sự AI biết — còn lại rơi về "stub".
AI_WORKFORCE_PROVIDER="stub"
# Khoá nhà cung cấp mô hình. ĐỂ TRỐNG là an toàn — thiếu khoá thì không lượt chạy nào tốn tiền.
AI_API_KEY=""
AI_BASE_URL="https://api.anthropic.com"
# Tên mô hình KHÔNG được ghi cứng trong mã. Đặt ở đây để đổi mô hình không phải sửa code.
# Ví dụ: AI_MODEL_ECONOMY="claude-haiku-4-5" · AI_MODEL_STRONG="claude-opus-5"
AI_MODEL_ECONOMY=""
AI_MODEL_STRONG=""
AI_TIMEOUT_MS="20000"
AI_MAX_OUTPUT_TOKENS="1024"
# Công tắc gọi mô hình. TẮT là mặc định: bật nhầm một lần là một hoá đơn thật.
AI_MODEL_CALLS_ENABLED="false"
# Nấc quyền hạn mặc định của nhân sự AI: OFF · SHADOW · COPILOT · AUTO.
# Giai đoạn này TRẦN là SHADOW — khai cao hơn cũng bị kẹp xuống, xem lib/constants/ai.ts::MAX_ALLOWED_MODE.
AI_DEFAULT_MODE="SHADOW"
# HAI CÔNG TẮC CHẶN CỨNG. Đọc THẲNG từ biến môi trường; bảng `settings` KHÔNG ghi đè được —
# xem lib/ai/config.ts::aiEnv.hardLimits. Chỉ đúng chuỗi "true" mở được (1/yes/on đều là CẤM),
# không khai gì cũng là CẤM. Đây là lớp ngoài cùng, nằm ngoài tầm với của mọi câu SQL.
AI_ALLOW_CUSTOMER_SEND="false"
AI_ALLOW_ORDER_CREATE="false"
# Hội thoại được phép nhận TIN KIỂM THỬ TẤT ĐỊNH (không phải câu do AI soạn), phân tách bằng dấu phẩy.
# Để trống trên production trừ khi đang chạy kiểm thử đường truyền.
AI_TEST_CONVERSATION_IDS=""

# ĐƠN GIÁ MÔ HÌNH và BẢNG SỐ ĐO không nằm ở biến môi trường — chúng là dữ liệu vận hành, đặt trong
# bảng `settings` để đổi được mà không phải triển khai lại:
#
#   settings["ai.config"].pricing        → { "<nhà cung cấp>:<mô hình>": { inputVndPerMillion,
#                                            outputVndPerMillion, cachedReadVndPerMillion?,
#                                            cacheWriteVndPerMillion? } }
#   settings["ai.config"].pricingVersion → tên phiên bản bảng giá, ghi vào từng lượt chạy
#   settings["ai.sizeRules"]             → { version, rules: [...] } — CHƯA CÓ DỮ LIỆU THẬT,
#                                          xem docs/ai-workforce.md §13
#
# Có token đệm mà chưa khai giá đệm ⇒ chi phí lượt đó là CHƯA BIẾT (null), không phải 0đ.
# Bí mật trong URL webhook hội thoại: https://<domain>/api/webhooks/pancake-chat/<PANCAKE_CHAT_WEBHOOK_SECRET>
# Để trống thì webhook trả 401 — ĐÓNG, không phải mở toang.
PANCAKE_CHAT_WEBHOOK_SECRET=""
