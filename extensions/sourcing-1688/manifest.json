{
  "manifest_version": 3,
  "name": "VNX ERP — Lưu mẫu từ 1688",
  "version": "1.0.0",
  "description": "Nút «Lưu mẫu vào ERP» trên trang chi tiết detail.1688.com. Chỉ chạy khi bạn bấm.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Cài đặt — Lưu mẫu từ 1688" },
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/offer/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://detail.1688.com/offer/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
