# ───────── BẢN CHẠY THỬ NHÂN SỰ AI (ai-staging) — MẪU, KHÔNG CHỨA BÍ MẬT THẬT ─────────
#
# Dùng cùng docker-compose.staging.yml, KHÔNG dùng chung với .env của production.
#   cp .env.staging.example .env.staging   (scripts/staging-up.sh làm hộ, kèm sinh bí mật tại chỗ)
#   chmod 600 .env.staging
#
# KHO MÃ NÀY LÀ PUBLIC. Tệp .env.staging đã nằm trong .gitignore; đừng dán token thật vào đây.
#
# Bốn khoá dưới đây được scripts/staging-up.sh sinh NGẪU NHIÊN NGAY TRÊN VPS bằng `openssl rand`
# nếu .env.staging chưa tồn tại — không phải gõ tay, và không bao giờ đi qua kho mã:
#   STAGING_POSTGRES_PASSWORD · AUTH_SECRET · CRON_SECRET · ADMIN_PASSWORD

# ───────────── Danh tính bản chạy thử ─────────────
# Cổng CHỈ nghe trên 127.0.0.1. Production giữ 3000; 3100 là của riêng bản chạy thử.
STAGING_PORT="3100"
# Mật khẩu CSDL staging — CSDL riêng, volume riêng, không liên quan CSDL production.
STAGING_POSTGRES_PASSWORD=""
# DATABASE_URL do docker-compose.staging.yml tự dựng từ STAGING_POSTGRES_PASSWORD.
# TUYỆT ĐỐI không trỏ vào CSDL production.

APP_URL="http://127.0.0.1:3100"

# ───────────── Bảo mật ứng dụng ─────────────
AUTH_SECRET=""
CRON_SECRET=""
ADMIN_EMAIL="admin@vnxcommerce.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Quản trị viên (chạy thử)"

# ───────────── Pancake: CHỈ ĐỌC HỘI THOẠI CỦA MỘT PAGE ─────────────
# Cách hẹp nhất, và là cách khuyên dùng cho bản chạy thử: token của CHÍNH page cần đọc.
# Token người dùng (PANCAKE_ACCESS_TOKEN) mở mọi page của tài khoản — không cần thì đừng cắm.
# Lấy ở pancake.vn → Cấu hình → Page → "Access token".
PANCAKE_PAGE_ID=""
PANCAKE_PAGE_ACCESS_TOKEN=""
# Để trống: bản chạy thử không cần token người dùng nếu đã có token page ở trên.
PANCAKE_ACCESS_TOKEN=""
PANCAKE_PAGES_BASE_URL="https://pages.fm/api/v1"

# Pancake POS (đơn hàng, sản phẩm). Để trống thì bản chạy thử không đồng bộ đơn hàng —
# đúng mong muốn ở giai đoạn này. Xem docs/ai-staging-plan.md §2 về cách nạp danh mục sản phẩm.
PANCAKE_API_KEY=""
PANCAKE_SHOP_ID=""
PANCAKE_BASE_URL="https://pos.pages.fm/api/v1"

# ───────────── NHỮNG THỨ CỐ TÌNH ĐỂ TRỐNG ─────────────
# docker-compose.staging.yml còn ép rỗng lần nữa ở khối `environment` (đè lên tệp này),
# nên dù ai điền nhầm vào đây thì container vẫn khởi động với giá trị rỗng.
#
# Webhook đơn hàng production: bản chạy thử KHÔNG nhận. Trùng bí mật = hai nơi cùng ghi một đơn.
PANCAKE_WEBHOOK_SECRET=""
# Viettel Post: bản chạy thử không tạo vận đơn, không nhận hành trình, không gọi API nào của VTP.
VIETTELPOST_API_KEY=""
VIETTELPOST_USERNAME=""
VIETTELPOST_PASSWORD=""
VIETTELPOST_WEBHOOK_SECRET=""
# Facebook Ads: không cần cho nhân sự Sales.
FACEBOOK_ACCESS_TOKEN=""
# Webhook hội thoại Pancake CHƯA kiểm chứng (docs/pancake-chat-setup.md §"Vì sao chưa bật").
# Giai đoạn này nạp bằng lệnh tay `npm run ai:ingest`. Để trống ⇒ webhook trả 401.
PANCAKE_CHAT_WEBHOOK_SECRET=""
# SePay (webhook tiền vào tài khoản, do main thêm): bản chạy thử KHÔNG nhận.
SEPAY_WEBHOOK_SECRET=""
SEPAY_WEBHOOK_API_KEY=""
SEPAY_API_TOKEN=""

# ───────────── Nhân sự AI ─────────────
# HAI CÔNG TẮC CHẶN CỨNG. Đọc THẲNG từ môi trường, không đọc từ bảng `settings` — không câu SQL
# nào, không màn hình quản trị nào bật được chúng. Chỉ nhận đúng chuỗi "true"; mọi giá trị khác
# (kể cả 1/yes/on) đều là CẤM.
# docker-compose.staging.yml ép "false" ở khối `environment`, đè lên tệp này.
AI_ALLOW_CUSTOMER_SEND="false"
AI_ALLOW_ORDER_CREATE="false"
# Trần quyền hạn giai đoạn này là SHADOW (lib/constants/ai.ts::MAX_ALLOWED_MODE) — khai cao hơn bị kẹp xuống.
AI_DEFAULT_MODE="SHADOW"

# Không có khoá mô hình thì hệ thống VẪN chạy: nhà cung cấp "stub" không gọi mạng, phần luật chạy
# bình thường, phần cần mô hình được đánh dấu "chưa dùng được" và chuyển người. Đó là hành vi đúng.
# TÊN RIÊNG. `AI_PROVIDER` là của AI Copilot trong ERP (auto|openai|anthropic|off); nhân sự AI
# dùng bộ khác (stub|anthropic). docker-compose.staging.yml ép "stub" ở khối `environment`.
# `stub` = KHÔNG gọi mạng. Giữ nguyên ở đây: một lần dựng bản chạy thử không bao giờ được tự gọi
# mô hình chỉ vì máy chủ tình cờ có khoá. Bật bằng ops `ai-staging-ai-env`, nó khai `erp` —
# cầu nối sang tầng AI có sẵn của ERP (dùng CHÍNH khoá OpenAI mà AI Copilot đang chạy).
AI_WORKFORCE_PROVIDER="stub"
# ĐƯỜNG LUI, không phải đường chính: chỉ dùng khi muốn tách hẳn hoá đơn của nhân sự bán hàng khỏi
# hoá đơn AI Copilot. Bỏ trống thì nhân sự bán hàng đi qua khoá chung của ERP.
AI_API_KEY=""
AI_BASE_URL="https://api.anthropic.com"
AI_MODEL_ECONOMY=""
AI_MODEL_STRONG=""
AI_TIMEOUT_MS="20000"
AI_MAX_OUTPUT_TOKENS="1024"
# Bật là bắt đầu tính tiền thật. Giai đoạn nạp thử đầu tiên cứ để "false".
AI_MODEL_CALLS_ENABLED="false"
# Để TRỐNG trên bản chạy thử cắm dữ liệu thật: đây là danh sách hội thoại được phép nhận tin.
AI_TEST_CONVERSATION_IDS=""

# ───────────── Bộ lập lịch ─────────────
# docker-compose.staging.yml KHÔNG có service scheduler, nên các biến lịch không có tác dụng.
# Giữ lại một dòng làm mốc cho lần bật sau, khi chủ shop đồng ý.
SYNC_AI_SALES_EVERY_MINUTES="10"
