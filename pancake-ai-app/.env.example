# Sao chép thành .env (KHÔNG commit .env). Mọi khoá cũng nhập được trong tab "Kết nối" của app —
# giá trị đã lưu trong app được ưu tiên hơn .env.

# Cổng & địa chỉ chạy. Giữ 127.0.0.1 nếu chỉ dùng trên máy mình.
HOST=127.0.0.1
PORT=8800

# Bắt buộc đặt khi mở app ra Internet (tunnel / VPS) — mã đăng nhập trang quản trị.
ADMIN_TOKEN=

# Địa chỉ công khai (vd https://abc.trycloudflare.com) — chỉ để app in đúng URL webhook.
PUBLIC_BASE_URL=

# (tuỳ chọn) Điền sẵn thay vì nhập trong app
PANCAKE_PAGE_ID=
PANCAKE_PAGE_ACCESS_TOKEN=
PANCAKE_SHOP_ID=
PANCAKE_POS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nơi lưu SQLite (mặc định ./data/pancake_ai.db)
# APP_DB_PATH=
